diff --git a/endpoints/OAI/utils/stream_parser.py b/endpoints/OAI/utils/stream_parser.py
index 5e9995d..e1a83c8 100644
--- a/endpoints/OAI/utils/stream_parser.py
+++ b/endpoints/OAI/utils/stream_parser.py
@@ -387,6 +387,53 @@ class GlimmerStreamParser(ChannelStreamParser):
         return CONTENT
 
 
+class InklingStreamParser(ChannelStreamParser):
+    """
+    Splits generated text in the Inkling-2 message format into
+    reasoning/content/tool channels.
+
+    Every message starts with `<|message_model|>`, an optional name, then a
+    content-type token that opens the body; `<|end_message|>` ends it:
+
+        <|message_model|><|content_thinking|>...reasoning...<|end_message|>
+        <|message_model|><|content_text|>...content...<|end_message|>
+        <|message_model|>NAME<|content_invoke_tool_json|>{"name":"NAME","args":{...}}<|end_message|>
+
+    The content-type token, not the header, gives the channel. Generation
+    begins before the first `<|message_model|>`; the turn ends with
+    `<|content_model_end_sampling|>`, a stop token. Tool messages are parsed
+    with the "inkling2" tool format.
+    """
+
+    _BODY_TOKENS = {
+        "<|content_thinking|>": REASONING,
+        "<|content_text|>": CONTENT,
+        "<|content_invoke_tool_json|>": TOOL,
+    }
+    _TOKENS = ["<|message_model|>", "<|end_message|>", "<|content_model_end_sampling|>", *_BODY_TOKENS]
+    _TOOL_END = "<|end_message|>"
+
+    def _resolve_channel(self, header: str) -> str:
+        # Headers carry a tool name at most; text messages are the default
+        return CONTENT
+
+    def _handle_token(self, token: str, events: list):
+        channel = self._BODY_TOKENS.get(token)
+        if channel is not None:
+            if self._state == self._HEADER:
+                self._channel = channel
+                if channel == TOOL:
+                    events.append((TOOL, self._header + token))
+                self._state = self._BODY
+            return
+
+        # <|message_model|> and the end tokens begin a new message header
+        if self._state == self._BODY and self._channel == TOOL:
+            events.append((TOOL, self._TOOL_END))
+        self._state = self._HEADER
+        self._header = ""
+
+
 def _merge_events(events: List[Tuple[str, str]]) -> List[Tuple[str, str]]:
     """Merge consecutive events on the same channel."""
 
diff --git a/endpoints/OAI/utils/toolcall_formats/inkling2.py b/endpoints/OAI/utils/toolcall_formats/inkling2.py
new file mode 100644
index 0000000..36a9f5e
--- /dev/null
+++ b/endpoints/OAI/utils/toolcall_formats/inkling2.py
@@ -0,0 +1,62 @@
+import json
+import re
+
+from common.logger import xlogger
+from endpoints.OAI.types.tools import ToolCall, Tool
+from endpoints.OAI.utils.toolcall_formats.common import FormatSignature
+
+"""
+Inkling-2 - structural message format with JSON tool calls
+
+A tool call is a model message named after the tool, with the
+`<|content_invoke_tool_json|>` content type. The Inkling stream parser emits
+each one on the tool channel as:
+
+    __NAME__<|content_invoke_tool_json|>{"name":"__NAME__","args":{...}}<|end_message|>
+
+The name inside the JSON body is authoritative; the header duplicates it.
+
+This format requires the Inkling stream parser and is selected automatically
+for Inkling-2 models; TOOLCALL_START/END are None since there are no tags for
+TagStreamParser to scan for.
+"""
+
+TOOLCALL_START = None
+TOOLCALL_END = None
+
+DETECT = FormatSignature(
+    template_markers=("<|content_invoke_tool_json|>", "<|message_model|>"),
+    special_tokens=("<|message_model|>", "<|content_invoke_tool_json|>", "<|end_message|>"),
+    architectures=("Inkling2",),
+    structured=True,
+)
+
+_CALL = re.compile(r"([^<]*)<\|content_invoke_tool_json\|>(.*?)(?:<\|end_message\|>|$)", re.DOTALL)
+
+
+def parse_toolcalls(text: str) -> list[ToolCall]:
+    results = []
+    for match in _CALL.finditer(text):
+        header, body = match.group(1).strip(), match.group(2).strip()
+        if not body:
+            continue
+        try:
+            call = json.loads(body)
+        except (json.JSONDecodeError, ValueError):
+            xlogger.warning("inkling2: Tool message body is not valid JSON", {"raw_text": body})
+            continue
+        if not isinstance(call, dict):
+            continue
+        name = call.get("name") or header
+        args = call.get("args", call.get("arguments", {}))
+        if not name:
+            continue
+        results.append(
+            ToolCall(function=Tool(name=name, arguments=json.dumps(args, ensure_ascii=False)))
+        )
+
+    xlogger.debug(
+        f"inkling2: Parsed {len(results)} tool calls",
+        {"raw_text": text, "results": results},
+    )
+    return results
